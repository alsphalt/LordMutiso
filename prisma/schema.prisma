// ============================================================
// DARKNOTE GAMING ARENA — Prisma schema
// Single datasource: Neon PostgreSQL via DATABASE_URL only.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum GameType {
  LUDO
  CHESS
  CHECKERS
}

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
  DRAW
  CANCELLED
  // Room-lifecycle states (GameRoom.status only — never used on Game.status)
  COMPLETED // game that used this room has finished
  CLOSED // room expired / abandoned
}

enum GameMode {
  ONLINE // multiplayer with real people
  AI // practice against computer opponents
}

enum AiDifficulty {
  EASY
  MEDIUM
  HARD
}

enum PlayerColor {
  RED
  YELLOW
  GREEN
  BLUE
  WHITE
  BLACK
}

enum NotificationType {
  INVITATION
  PLAYER_JOINED
  GAME_STARTED
  YOUR_TURN
  GAME_ENDED
  REMATCH
  CHAT
  SYSTEM
}

// ---------- Auth & users ----------

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the raw session token (never stored raw)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  image        String? // avatar URL; falls back to generated initials avatar
  country      String? // ISO 3166-1 alpha-2 (e.g. "KE"); chosen at registration
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSeen     DateTime @default(now())

  statistics    UserStatistics?
  avatar        UserAvatar?
  sessions      Session[]
  createdGames  Game[]          @relation("GameCreator")
  wonGames      Game[]          @relation("GameWinner")
  gamePlayers   GamePlayer[]
  chatMessages  ChatMessage[]
  notifications Notification[]
  // Games this user is currently in (derived via GamePlayer for UI)

  // ---------- Social (DMs, updates, privacy) ----------
  displayName    String?
  bio            String?
  phone          String?              @unique
  onboardingDone Boolean              @default(false)
  privacy        PrivacySettings?
  convMembers    ConversationMember[]
  sentMessages   Message[]            @relation("MessageSender")
  contactsOwned  ContactEdge[]        @relation("ContactOwner")
  contactsOf     ContactEdge[]        @relation("ContactTarget")
  blocked        Block[]              @relation("BlockOwner")
  blockedBy      Block[]              @relation("BlockTarget")
  createdConversations Conversation[]  @relation("ConversationCreator")
  stories        Story[]
  storyViews     StoryView[]
  storyAudience  StoryRecipient[]
  Report         Report[]

  @@index([lastSeen])
  @@index([createdAt])
}

model UserStatistics {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gamesPlayed Int @default(0)
  gamesWon    Int @default(0)
  gamesLost   Int @default(0)
  draws       Int @default(0)
  rating      Int @default(1000)

  ludoWins     Int @default(0)
  chessWins    Int @default(0)
  checkersWins Int @default(0)

  // Practice (AI) games — kept fully separate from competitive online stats
  aiGames Int @default(0)
  aiWins  Int @default(0)
  aiDraws Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Profile avatars (uploaded, DB-backed; no external storage) ----------

model UserAvatar {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Compressed image bytes (client-side resized to <=512px; validated server-side).
  data      Bytes
  mime      String   @default("image/webp")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([updatedAt])
}

// ---------- Games ----------

model Game {
  id                 String        @id @default(cuid())
  type               GameType
  gameMode           GameMode      @default(ONLINE)
  aiDifficulty       AiDifficulty? // difficulty of the AI opponents in AI-mode games
  status             GameStatus    @default(WAITING)
  createdBy          String
  creator            User          @relation("GameCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  winnerId           String?
  winner             User?         @relation("GameWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  winnerPlayerNumber Int? // seat number of the winner (works for AI seats too)

  // JSON board/game state (authoritative, maintained server-side only)
  gameState   Json @default("{}")
  currentTurn Int? // 1-based playerNumber whose turn it is; null when not playing

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?
  updatedAt DateTime  @updatedAt

  players       GamePlayer[]
  moves         GameMove[]
  room          GameRoom?
  chat          ChatMessage[]
  notifications Notification[]

  @@index([status])
  @@index([type])
  @@index([createdBy])
  @@index([createdAt])
}

model GamePlayer {
  id           String      @id @default(cuid())
  gameId       String
  game         Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId       String? // null for AI seats
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAi         Boolean     @default(false)
  botName      String? // display name for AI seats (e.g. "Bot · Medium")
  playerNumber Int // 1-based seat (board corner slot for Ludo)
  color        PlayerColor
  score        Int         @default(0)
  joinedAt     DateTime    @default(now())

  moves GameMove[]

  // A user cannot occupy two seats in the same game
  @@unique([gameId, userId])
  @@index([gameId, playerNumber])
  @@index([userId])
}

model GameMove {
  id         String     @id @default(cuid())
  gameId     String
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId   String
  player     GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  moveNumber Int
  moveData   Json // per-game move payload, validated server-side
  createdAt  DateTime   @default(now())

  @@unique([gameId, moveNumber])
  @@index([gameId])
  @@index([playerId])
}

model GameRoom {
  id         String     @id @default(cuid())
  // Quick-match rooms have NO code (null). Private rooms carry a unique code.
  roomCode   String?    @unique
  // Human friendly room name — required for quick-match rooms, optional for private.
  roomName   String?
  // One-time-use guard for private room codes: set true once a player joins by code.
  codeUsed   Boolean    @default(false)
  // WAITING rooms expire after 24h (quick-match lobby discovery window).
  expiresAt  DateTime?
  gameId     String     @unique
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  maxPlayers Int
  status     GameStatus @default(WAITING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status])
  @@index([expiresAt])
}

// ---------- Chat ----------

model ChatMessage {
  id        String   @id @default(cuid())
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  gameId    String? // null  -> global chat
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([gameId, id])
  @@index([senderId])
}

// ---------- Notifications ----------

model Notification {
  id        String           @id @default(cuid())
  userId    String // recipient
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  gameId    String?
  game      Game?            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

// ---------- Social: DMs, privacy, contacts, updates ----------

enum ConversationKind {
  DM
  GROUP
}

enum MessageKind {
  TEXT
  IMAGE
}

enum VisibilityLevel {
  EVERYONE
  CONTACTS
  NOBODY
}

enum UpdateVisibility {
  CONTACTS
  SELECTED
  ONLY_ME
}

model Conversation {
  id          String           @id @default(cuid())
  kind        ConversationKind @default(DM)
  dmKey       String?          @unique // `${minId}:${maxId}` for DM — prevents duplicates
  name        String? // group name
  avatarUrl   String? // group image
  createdById String? // group creator
  creator     User?            @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastAt      DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  archivedAt     DateTime? // user hides the conversation locally
  mutedAt        DateTime? // muted notifications
  lastTypingAt   DateTime? // typing heartbeat for this user in this conversation
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, archivedAt])
  @@index([conversationId, lastReadAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  kind           MessageKind  @default(TEXT)
  content        String       @default("")
  mediaUrl       String?
  deliveredAt    DateTime? // set once the recipient has fetched it
  deletedAt      DateTime? // soft delete (own messages)
  createdAt      DateTime     @default(now())

  @@index([conversationId, id])
  @@index([senderId])
}

model ContactEdge {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactId String
  contact   User     @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, contactId])
  @@index([contactId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockOwner", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reporter       User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetId       String
  conversationId String?
  reason         String   @default("")
  createdAt      DateTime @default(now())

  @@index([reporterId])
  @@index([targetId])
}

model PrivacySettings {
  userId         String           @id
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  findability    VisibilityLevel  @default(EVERYONE)
  messaging      VisibilityLevel  @default(EVERYONE)
  online         VisibilityLevel  @default(EVERYONE)
  profilePhoto   VisibilityLevel  @default(EVERYONE)
  lastSeen       VisibilityLevel  @default(EVERYONE)
  updates        UpdateVisibility @default(CONTACTS)
  allowDiscovery Boolean          @default(false)
  updatedAt      DateTime         @updatedAt
}

model Story {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       MessageKind      @default(TEXT)
  text       String?
  mediaUrl   String?
  visibility UpdateVisibility @default(CONTACTS)
  createdAt  DateTime         @default(now())
  expiresAt  DateTime?
  deletedAt  DateTime?
  viewers    StoryView[]
  audience   StoryRecipient[]

  @@index([userId, createdAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, viewerId])
}

model StoryRecipient {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}
